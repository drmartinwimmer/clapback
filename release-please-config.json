{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "plugins": [
    {
      "type": "cargo-workspace"
    },
    {
      "type": "linked-versions",
      "groupName": "clapback-workspace",
      "components": ["clapback", "clapback-derive"]
    }
  ],
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "clapback",
      "component": "clapback"
    },
    "crates/clapback-derive": {
      "release-type": "rust",
      "package-name": "clapback-derive",
      "component": "clapback-derive"
    }
  }
}
